{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#ff0000"
    },
    "width": 40,
    "height": 19,
    "padding": {
      "top": 3,
      "bottom": 3,
      "left": 7
    }
  },
  "display": {
    "separator": ":",
    "color": {
      "title": "#ff79c6",
      "keys": "#7aa2f7",
      "separator": "#7aa2f7"
    },
    "brightColor": true
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
